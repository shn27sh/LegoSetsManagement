# Copy this file to "config.env" in the ZIP root folder (next to Launch.bat).

# Rebrickable API key (optional; required for sync from Rebrickable)
# REBRICKABLE_API_KEY=your-api-key-here

# Server port (default 8000)
# LCM_PORT=8000

# Set to 0 to skip opening the browser automatically
# LCM_OPEN_BROWSER=1

# Logging: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=WARNING
