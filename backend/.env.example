# Copy to `.env` in this directory (backend/) when running uvicorn or Alembic from `backend/`.

# SQLite database file (relative paths are resolved from the current working directory).
DATABASE_URL=sqlite:///./data/lego.db

# Logging level for importer and app logs (DEBUG, INFO, WARNING, …).
LOG_LEVEL=WARNING
# Local server log file. *.log files are ignored by git.
# LOG_FILE_PATH=./data/server.log
# LOG_FILE_MAX_BYTES=1048576
# LOG_FILE_BACKUP_COUNT=5
# Dedicated JSON-lines text file for failed imports/syncs/image downloads.
# IMPORT_FAILURE_LOG_PATH=./data/import_failures.log
# Comma-separated Rebrickable set keys from the last CSV import or sync (retry file).
# FAILED_SETS_CSV_PATH=./data/failedSets.csv

# Set to 1 only for tests or special local setups (skips Alembic head check on startup).
# SKIP_DB_MIGRATION_CHECK=1

# Optional legacy path (Phase 10+ stores images in SQLite BLOBs; not required).
# UPLOAD_ROOT=./data/uploads
# MAX_IMAGE_BYTES=5242880

# Rebrickable API v3 (required for sync in Phase 4B; client tests use mocks only).
REBRICKABLE_API_KEY=your-api-key-here
# REBRICKABLE_BASE_URL=https://rebrickable.com/api/v3/
# REBRICKABLE_TIMEOUT_SECONDS=30
# REBRICKABLE_MAX_RETRIES=3
# Min seconds between API calls (Rebrickable allows ~1 req/s average; 429 if exceeded).
# REBRICKABLE_MIN_REQUEST_INTERVAL_SECONDS=1.0

# CDN image downloads during Rebrickable sync (shared client per job; throttled).
# IMAGE_DOWNLOAD_TIMEOUT_SECONDS=20
# IMAGE_DOWNLOAD_MIN_INTERVAL_SECONDS=0.3

# Optional path to Rebrickable elements.csv for import-time LEGO Element ID enrichment.
# Defaults to ../data/elements.csv when running from backend/.
# ELEMENTS_CSV_PATH=../data/elements.csv

# Optional path to Rebrickable themes.csv for import-time parent-theme resolution.
# Defaults to ../data/themes.csv when running from backend/.
# THEMES_CSV_PATH=../data/themes.csv

# Optional paths for the Import page local metadata update.
# Defaults to ../data/age.csv and ../data/sets.csv when running from backend/.
# AGE_CSV_PATH=../data/age.csv
# SETS_CSV_PATH=../data/sets.csv
